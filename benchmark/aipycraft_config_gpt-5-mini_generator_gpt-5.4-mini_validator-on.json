{
  "schema_version": 2,
  "api": {
    "base_url": "https://openrouter.ai/api/v1",
    "model": "openai/gpt-5-mini",
    "provider_only": ["openai"],
    "allow_fallbacks": false,
    "temperature": null,
    "reasoning_effort": "low",
    "transport_retries": 1,
    "input_usd_per_million": "0.25",
    "output_usd_per_million": "2.00"
  },
  "pipeline": {
    "max_regenerations": 5,
    "candidate_api_loss_confirmation_replays": 1,
    "runtime_observation_seconds": 30,
    "runtime_poll_seconds": 2,
    "command_timeout_seconds": 120,
    "output_root": "benchmark/aipycraft_runs"
  },
  "ai_validator": {
    "enabled": true,
    "feedback_mode": "detailed",
    "shadow_mode": false,
    "api_override": {
      "model": "openai/gpt-5.4-mini",
      "reasoning_effort": "low",
      "input_usd_per_million": "0.75",
      "output_usd_per_million": "4.50"
    }
  },
  "environment": {
    "lock_file": "benchmark/environment/environment.lock.json",
    "kind_config": "benchmark/environment/kind-cluster.yaml",
    "cache_root": ".aipycraft/cache"
  },
  "prompts": {
    "generate": "benchmark/prompts/aipycraft_k8s_generate.txt",
    "regenerate": "benchmark/prompts/aipycraft_k8s_regenerate.txt",
    "validator_detailed": "benchmark/prompts/aipycraft_k8s_validate_detailed.txt",
    "validator_verdict_only": "benchmark/prompts/aipycraft_k8s_validate_verdict.txt"
  }
}
