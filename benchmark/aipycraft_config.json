{
  "schema_version": 1,
  "api": {
    "base_url": "https://openrouter.ai/api/v1",
    "model": "qwen/qwen3-coder",
    "provider_only": ["deepinfra"],
    "allow_fallbacks": false,
    "temperature": 0.0,
    "transport_retries": 1,
    "input_usd_per_million": "0.30",
    "output_usd_per_million": "1.00"
  },
  "pipeline": {
    "max_regenerations": 5,
    "runtime_observation_seconds": 30,
    "runtime_poll_seconds": 2,
    "command_timeout_seconds": 120,
    "output_root": "benchmark/aipycraft_runs"
  },
  "environment": {
    "lock_file": "benchmark/environment/environment.lock.json",
    "kind_config": "benchmark/environment/kind-cluster.yaml",
    "cache_root": ".aipycraft/cache"
  },
  "prompts": {
    "generate": "benchmark/prompts/aipycraft_k8s_generate.txt",
    "regenerate": "benchmark/prompts/aipycraft_k8s_regenerate.txt"
  }
}
